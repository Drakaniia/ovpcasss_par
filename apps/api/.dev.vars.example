# Copy to .dev.vars for `wrangler dev`. Never commit real values (spec §10).
SESSION_SECRET=replace-me

# Mail. EMAIL_PROVIDER is the adapter (brevo | resend | cloudflare | console);
# console prints each message to the wrangler log and sends nothing. EMAIL_FROM
# must be an address verified in the provider's dashboard.
EMAIL_PROVIDER=brevo
EMAIL_FROM="OVPCASSS PAR <you@gmail.com>"
EMAIL_REPLY_TO="ovpcasss@buksu.edu.ph"
EMAIL_API_KEY=replace-me

# R2 file storage. All three or none: while they are placeholders, presign
# answers 503 STORAGE_UNAVAILABLE and the uploader falls back to proxy mode
# through the Worker's R2 binding, so local development needs no R2 API token.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# Google sign-in: set both or neither. In the Google console use JavaScript
# origin http://localhost:5173 and redirect URI
# http://localhost:5173/api/v1/auth/google/callback.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Absolute app URL for links in mail and receipts; wrangler.toml carries the
# deployed value, this one overrides it locally.
APP_ORIGIN=http://localhost:5173
