{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OVPCASSS Paperless PAR",
  "version": "0.0.0",
  "identifier": "ph.edu.ovpcasss.par",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @par/web dev",
    "beforeBuildCommand": "pnpm --filter @par/web build"
  },
  "app": {
    "windows": [
      {
        "title": "OVPCASSS Paperless PAR",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.example.edu"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
