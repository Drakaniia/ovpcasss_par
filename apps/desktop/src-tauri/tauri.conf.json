{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OVPCASSS Paperless PAR",
  "version": "0.1.0",
  "identifier": "ph.edu.ovpcasss.par",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @par/web --filter @par/api dev",
    "beforeBuildCommand": "pnpm --filter @par/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OVPCASSS Paperless PAR",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "focus": false,
        "backgroundColor": [250, 248, 244, 255]
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "OVPCASSS Paperless PAR",
        "width": 420,
        "height": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "center": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "backgroundColor": [250, 248, 244, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://par-api.floresaybaez574.workers.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Drakaniia/ovpcasss_par/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RENBNDFBRDRFRkRCQzMKUldURDIrL1VHcVRjNXJyamk4MElITExuaWlLdDNqaGI3ZVBsMXQ2VE96SzFjVi94ekFKNkZXdnAK"
    }
  }
}
